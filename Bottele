# Lệnh Admin: Thêm key vào hệ thống (/themkey <mission_id> <key>)
async def themkey(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_id = update.effective_user.id
  if user_id != ADMIN_ID:
    await update.message.reply_text("⛔ Bạn không có quyền dùng lệnh này!")
    return

  if len(context.args) < 2:
    await update.message.reply_text(
        "⚠️ Cú pháp: `/themkey <nhiem_vu_id> <ma_key>`", parse_mode="Markdown"
    )
    return

  mission_id = context.args[0]
  key_string = context.args[1]

  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()
  try:
    cursor.execute(
        "INSERT INTO keys (key_string, mission_id, is_used) VALUES (?, ?, 0)",
        (key_string, mission_id),
    )
    conn.commit()
    await update.message.reply_text(
        f"✅ Đã thêm key `{key_string}` cho nhiệm vụ {mission_id} thành công!"
    )
  except sqlite3.IntegrityError:
    await update.message.reply_text("❌ Key này đã tồn tại trong database!")
  conn.close()


def main():
  app = ApplicationBuilder().token(TOKEN).build()

  # Đăng ký các Handler lệnh
  app.add_handler(CommandHandler("start", start))
  app.add_handler(CommandHandler("nhanxu", nhanxu))
  app.add_handler(CommandHandler("sodu", sodu))
  app.add_handler(CommandHandler("nhapkey", nhapkey))
  app.add_handler(CommandHandler("doiqua", doiqua))
  app.add_handler(CommandHandler("help", help_command))
  app.add_handler(CommandHandler("themkey", themkey))

  print("🤖 Bot đang chạy...")
  app.run_polling()


if __name__ == "__main__":
  main()