# Khởi tạo Database SQLite
def init_db():
  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()
  # Bảng người dùng và số dư
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            balance INTEGER DEFAULT 0
        )
    """)
  # Bảng key tương ứng với 5 nhiệm vụ (mission_id từ 1 đến 5)
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS keys (
            key_string TEXT PRIMARY KEY,
            mission_id INTEGER,
            is_used INTEGER DEFAULT 0
        )
    """)
  # Bảng lưu trạng thái nhiệm vụ của từng user (0: 🟢 chưa làm, 1: 🔴 đã làm)
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS user_tasks (
            user_id INTEGER,
            mission_id INTEGER,
            status INTEGER DEFAULT 0,
            PRIMARY KEY (user_id, mission_id)
        )
    """)
  conn.commit()
  conn.close()


init_db()


# Hàm xử lý lệnh /start (Hỗ trợ cả Deep Linking /start <key>)
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_id = update.effective_user.id

  # Đảm bảo user có trong DB
  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()
  cursor.execute(
      "INSERT OR IGNORE INTO users (user_id, balance) VALUES (?, 0)", (user_id,)
  )
  conn.commit()

  # 1. Nếu user vào bot qua link rút gọn có kèm key (Deep Linking)
  if context.args:
    key_input = context.args[0]
    cursor.execute(
        "SELECT mission_id, is_used FROM keys WHERE key_string = ?",
        (key_input,),
    )
    row = cursor.fetchone()

    if row:
      mission_id, is_used = row
      if is_used == 1:
        await update.message.reply_text(
            "❌ Key này đã được sử dụng trước đó rồi!"
        )
      else:
        # Đánh dấu key đã dùng
        cursor.execute(
            "UPDATE keys SET is_used = 1 WHERE key_string = ?", (key_input,)
        )
        # Cộng 1 xu cho user
        cursor.execute(
            "UPDATE users SET balance = balance + 1 WHERE user_id = ?",
            (user_id,),
        )
        # Cập nhật trạng thái nhiệm vụ thành 🔴 (đã hoàn thành)
        cursor.execute(
            """INSERT OR REPLACE INTO user_tasks (user_id, mission_id, status)
                       VALUES (?, ?, 1)""",
            (user_id, mission_id),
        )
        conn.commit()
        await update.message.reply_text(
            f"🎉 Xác thực thành công Nhiệm vụ {mission_id}! Bạn nhận được +1 Xu."
        )
    else:
      await update.message.reply_text("❌ Mã Key không tồn tại trong hệ thống!")

    conn.close()
    return

  conn.close()

  # 2. Gõ /start bình thường
  welcome_text = (
      "🤖 **Xin chào! Chào mừng bạn đến với Bot Kiếm Xu.**\n\n"
      "🔹 **Các lệnh chính:**\n"
      "• `/nhanxu` — Mở menu 5 nhiệm vụ nhận key\n"
      "• `/nhapkey <key>` — Nhập key thủ công\n"
      "• `/sodu` — Xem số dư xu hiện tại\n"
      "• `/doiqua` — Đổi lượt buff Like Free Fire\n"
      "• `/help` — Xem hướng dẫn chi tiết"
  )
  await update.message.reply_text(welcome_text, parse_mode="Markdown")


# Hàm hiển thị 5 nhiệm vụ với trạng thái 🟢 / 🔴
async def nhanxu(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_id = update.effective_user.id
  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()

  keyboard = []
  for i in range(1, 6):
    cursor.execute(
        "SELECT status FROM user_tasks WHERE user_id = ? AND mission_id = ?",
        (user_id, i),
    )
    row = cursor.fetchone()
    status = row[0] if row else 0

    icon = "🔴" if status == 1 else "🟢"
    # Thay link bên dưới bằng link rút gọn Link4M / Traffic1s của bạn tương ứng với từng nhiệm vụ
    short_links = {
        1: "https://link4m.co/your_link_1",
        2: "https://link4m.co/your_link_2",
        3: "https://link4m.co/your_link_3",
        4: "https://link4m.co/your_link_4",
        5: "https://link4m.co/your_link_5",
    }
    link_url = short_links.get(i, "https://t.me/")

    keyboard.append([
        InlineKeyboardButton(
            f"Nhiệm vụ {i} (+1 Xu) {icon}", url=link_url
        )
    ])

  conn.close()
  reply_markup = InlineKeyboardMarkup(keyboard)
  await update.message.reply_text(
      "📌 **Danh sách nhiệm vụ vượt link kiếm xu:**\nBấm vào các nút bên dưới để làm nhiệm vụ:",
      reply_markup=reply_markup,
      parse_mode="Markdown",
  )


# Hàm kiểm tra số dư /sodu
async def sodu(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_id = update.effective_user.id
  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()
  cursor.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))
  row = cursor.fetchone()
  balance = row[0] if row else 0
  conn.close()

  await update.message.reply_text(f"💰 Số dư hiện tại của bạn là: **{balance} Xu**", parse_mode="Markdown")


# Hàm nhập key thủ công /nhapkey
async def nhapkey(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_id = update.effective_user.id
  if not context.args:
    await update.message.reply_text(
        "⚠️ Vui lòng nhập đúng cú pháp: `/nhapkey <ma_key>`", parse_mode="Markdown"
    )
    return

  key_input = context.args[0]
  conn = sqlite3.connect("bot_data.db")
  cursor = conn.cursor()
  cursor.execute(
      "SELECT mission_id, is_used FROM keys WHERE key_string = ?", (key_input,)
  )
  row = cursor.fetchone()

  if row:
    mission_id, is_used = row
    if is_used == 1:
      await update.message.reply_text("❌ Key này đã được sử dụng rồi!")
    else:
      cursor.execute(
          "UPDATE keys SET is_used = 1 WHERE key_string = ?", (key_input,)
      )
      cursor.execute(
          "UPDATE users SET balance = balance + 1 WHERE user_id = ?", (user_id,)
      )
      cursor.execute(
          """INSERT OR REPLACE INTO user_tasks (user_id, mission_id, status)
                   VALUES (?, ?, 1)""",
          (user_id, mission_id),
      )
      conn.commit()
      await update.message.reply_text(
          f"🎉 Nhập key thành công! Bạn nhận được +1 Xu từ nhiệm vụ {mission_id}."
      )
  else:
    await update.message.reply_text("❌ Mã key không hợp lệ!")

  conn.close()


